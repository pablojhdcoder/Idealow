PORT=3001
# Local con Docker: ver docker-compose.yml (postgres / password). Puerto 5433 = contenedor pgvector.
# Si Prisma dice "extensión vector no está disponible", suele estar conectando al Postgres de Windows
# en 5432; usa 5433 o para el servicio nativo.
DATABASE_URL=postgresql://postgres:password@localhost:5433/idealow?schema=public
JWT_SECRET=replace_with_a_long_random_secret

# Microsoft Foundry / Azure OpenAI (recurso Cognitive Services / Foundry)
# Endpoint: https://<recurso>.openai.azure.com  (sin /openai al final)
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_KEY=
# API version; sube si Azure documenta una más reciente para tus modelos
OPENAI_API_VERSION=2024-12-01-preview

# SOLO el nombre del deployment (ej. mi-gpt54-nano), NO una URL ni ?api-version=...
# Recomendado: un deployment de gpt-5.4-nano para chat + visión + extracción
AZURE_OPENAI_DEPLOYMENT_CHAT=

# Opcional: deployments distintos por tarea (si no se definen, se usa CHAT)
# AZURE_OPENAI_DEPLOYMENT_EXTRACTION=
# AZURE_OPENAI_DEPLOYMENT_SUGGESTIONS=
# AZURE_OPENAI_DEPLOYMENT_VISION=

# Obligatorio solo si procesas audio; SOLO nombre del deployment whisper (ej. whisper)
# AZURE_OPENAI_DEPLOYMENT_WHISPER=

# Embeddings / búsqueda semántica (pgvector). Nombre del deployment en Azure (p. ej. text-embedding-3-small).
# Si no se define, se usa EMBEDDING_MODEL como nombre de deployment.
# AZURE_OPENAI_DEPLOYMENT_EMBEDDINGS=text-embedding-3-small
EMBEDDING_MODEL=text-embedding-3-small
# Opcional: validar dimensión del vector (por defecto 1536 para text-embedding-3-small)
# EMBEDDING_DIMENSIONS=1536
UPLOAD_DIR=./uploads
MAX_UPLOAD_MB=25
YOUTUBE_API_KEY=
NODE_ENV=development
# Orígenes del SPA permitidos por CORS (separados por coma). Preview + prod: varias URLs.
# CORS_ORIGIN=http://localhost:3000,https://preview.tudominio.com,https://app.tudominio.com
CORS_ORIGIN=http://localhost:3000
# Tras proxy inverso / load balancer (CubePath, nginx): true, o número de proxies (p. ej. 1)
# TRUST_PROXY=1
PRISMA_CLIENT_ENGINE_TYPE=binary

generator client {
  provider = "prisma-client-js"
  engineType = "binary"
}

datasource db {
  provider = "postgresql"
}

model User {
  id              String   @id @default(uuid())
  email           String   @unique
  username        String   @unique
  passwordHash    String
  avatarUrl       String?
  bio             String?
  sectors         String[] @default([])
  experienceLevel String   @default("BEGINNER")
  goal            String   @default("SIDE_PROJECT")
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  ideas    Idea[]
  feedback IdeaFeedback[]
  files    File[]
}

model Idea {
  id     String @id @default(uuid())
  userId String
  user   User   @relation(fields: [userId], references: [id])

  title      String
  summary    String?
  rawContent String?
  files      File[]

  status String @default("DRAFT")

  sector          String?
  refinedContent  Json?
  embedding       Unsupported("vector(1536)")?
  validationScore Int?
  validationData  Json?
  competitors     Json?

  /** Lease entre réplicas: solo una validación en curso por idea (TTL vía consulta stale). */
  validationStartedAt DateTime?

  isPublished Boolean  @default(true)
  publishedAt DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  feedback IdeaFeedback[]

  @@index([isPublished, publishedAt])
}

model File {
  id           String  @id @default(uuid())
  userId       String
  user         User    @relation(fields: [userId], references: [id])
  ideaId       String?
  idea         Idea?   @relation(fields: [ideaId], references: [id])
  filepath     String
  originalName String
  mimeType     String
  sizeBytes    Int
  sourceText   String?
  embedding    Unsupported("vector(1536)")?
  createdAt    DateTime @default(now())

  @@index([userId, createdAt])
  @@index([ideaId])
}

model IdeaFeedback {
  id     String @id @default(uuid())
  ideaId String
  idea   Idea   @relation(fields: [ideaId], references: [id])
  userId String
  user   User   @relation(fields: [userId], references: [id])

  vote    String
  comment String?

  createdAt DateTime @default(now())

  @@unique([ideaId, userId])
}
